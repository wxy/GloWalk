    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk uses the rear camera to sense ambient brightness. No photos, no video, no storage."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 用后摄像头感知环境明暗变化，不拍照、不录像、不存储任何画面。拒绝后需手动调节亮度。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk は背面カメラで周囲の明るさを感知します。写真や動画は撮影・保存しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk는 후면 카메라로 주변 밝기를 감지합니다. 사진이나 영상을 촬영하거나 저장하지 않습니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk utilise la caméra arrière pour détecter la luminosité ambiante. Aucune photo, aucune vidéo, aucune conservation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk nutzt die Rückkamera, um die Umgebungshelligkeit zu erfassen. Keine Fotos, kein Video, keine Speicherung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk usa la cámara trasera para detectar la luz ambiental. Sin fotos, sin vídeos, sin almacenamiento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GloWalk usa a câmera traseira para detectar a luminosidade ambiente. Sem fotos, sem vídeos, sem armazenamento."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk usa la fotocamera posteriore per rilevare la luminosità ambientale. Niente foto, niente video, nessuna memorizzazione."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk использует заднюю камеру для определения окружающей освещённости. Без фото, без видео, без сохранения."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk uses your location to record your walking path and to fetch current weather (via Apple WeatherKit or Open-Meteo)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 使用你的位置记录步行路径，并用于获取当前天气（通过 Apple WeatherKit 或 Open-Meteo）。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk は歩行経路の記録と現在の天気の取得（Apple WeatherKit / Open-Meteo）に位置情報を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk는 걷기 경로를 기록하고 현재 날씨를 가져오기 위해(Apple WeatherKit / Open-Meteo) 위치 정보를 사용합니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk utilise votre position pour enregistrer votre parcours et obtenir la météo actuelle (via Apple WeatherKit ou Open-Meteo)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk nutzt Ihren Standort, um Ihren Weg aufzuzeichnen und das aktuelle Wetter abzurufen (über Apple WeatherKit oder Open-Meteo)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk usa tu ubicación para registrar tu ruta y obtener el tiempo actual (a través de Apple WeatherKit u Open-Meteo)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GloWalk usa sua localização para registrar seu trajeto e obter o clima atual (via Apple WeatherKit ou Open-Meteo)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk usa la tua posizione per registrare il percorso e ottenere il meteo attuale (tramite Apple WeatherKit o Open-Meteo)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk использует вашу геопозицию для записи маршрута и получения текущей погоды (через Apple WeatherKit или Open-Meteo)."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk uses motion sensors to detect walking state and phone posture for adaptive brightness."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 用运动传感器识别步行状态和手机持握姿态，自动调节闪光灯亮度。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk は歩行状態とスマホの姿勢を認識し、フラッシュの明るさを自動調整するためにモーションセンサーを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk는 걷기 상태와 기기 자세를 인식해 플래시 밝기를 자동으로 조절하기 위해 모션 센서를 사용합니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk utilise les capteurs de mouvement pour détecter l'état de marche et la posture du téléphone et ajuster automatiquement la luminosité de la torche."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk nutzt Bewegungssensoren, um Gehstatus und Handyhaltung zu erkennen und die Taschenlampenhelligkeit automatisch anzupassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk usa sensores de movimiento para detectar el estado de marcha y la postura del teléfono y ajustar automáticamente el brillo de la linterna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GloWalk usa sensores de movimento para detectar o estado de caminhada e a postura do aparelho e ajustar automaticamente o brilho da lanterna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk usa i sensori di movimento per rilevare lo stato di camminata e la postura del telefono e regolare automaticamente la luminosità della torcia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk использует датчики движения для определения состояния ходьбы и положения телефона и автоматической регулировки яркости фонарика."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save night walk posters to your photo library."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存夜路海报到相册。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜の歩行ポスターをフォトライブラリに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "밤 산책 포스터를 사진 보관함에 저장합니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer les posters de marches nocturnes dans votre photothèque."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachtposter von Spaziergängen in Ihrer Fotomediathek speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar los pósters de paseos nocturnos en tu fototeca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar os pôsteres de caminhadas noturnas na sua biblioteca de fotos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva i poster delle passeggiate notturne nella tua libreria foto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранение ночных постеров прогулок в вашу фотобиблиотеку."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk writes your walking records (steps, distance, duration and route) to the Health app. Data stays on your device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 会把你的步行记录（步数、距离、时长和路线）写入健康 App，用于生成运动记录。数据仅保存在你的设备上，不会上传。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 會把你的步行記錄（步數、距離、時長和路線）寫入健康 App，用於生成運動記錄。資料僅保存在你的裝置上，不會上傳。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk は歩行記録（歩数・距離・時間・経路）をヘルスケア App に書き込み、運動記録を生成します。データは端末内にのみ保存され、アップロードされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk는 걷기 기록(걸음 수·거리·시간·경로)을 건강 App에 기록해 운동 기록을 생성합니다. 데이터는 기기에만 저장되며 업로드되지 않습니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk écrit vos enregistrements de marche (pas, distance, durée et trajet) dans l'app Santé pour créer des séances d'exercice. Les données restent sur votre appareil et ne sont pas téléchargées."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk schreibt Ihre Gehdaten (Schritte, Distanz, Dauer und Route) in die Health-App, um Trainingseinheiten zu erzeugen. Die Daten bleiben auf Ihrem Gerät und werden nicht hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk escribe tus registros de caminata (pasos, distancia, duración y ruta) en la app Salud para generar sesiones de ejercicio. Los datos permanecen en tu dispositivo y no se suben."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GloWalk grava seus registros de caminhada (passos, distância, duração e trajeto) no app Saúde para gerar sessões de exercício. Os dados ficam no seu aparelho e não são enviados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk scrive i tuoi record di camminata (passi, distanza, durata e percorso) nell'app Salute per creare sessioni di allenamento. I dati restano sul tuo dispositivo e non vengono caricati."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk записывает ваши данные о прогулках (шаги, дистанция, длительность и маршрут) в приложение «Здоровье» для создания тренировок. Данные остаются на вашем устройстве и не загружаются."
          }
        }
      }
    },
