    "help.autoDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk senses ambient brightness via the rear camera and combines phone posture, dark adaptation, moon phase, and weather to compute optimal brightness in real time. No manual input needed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 通过后置摄像头感知环境明暗，结合手机姿态、暗适应、月相和天气，实时计算最合适的亮度。无需手动操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 透過後置鏡頭感知環境明暗，結合手機姿態、暗適應、月相和天氣，即時計算最合適的亮度。無需手動操作。"
          }
        }
      }
    },
    "help.autoTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto Brightness"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动调光"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動調光"
          }
        }
      }
    },
    "help.dismissDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe down on the poster to dismiss it and return to walk history."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在海报页面向下滑动即可关闭，返回步行历史。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在海報頁面向下滑動即可關閉，返回步行歷史。"
          }
        }
      }
    },
    "help.dismissTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dismiss Poster"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭海报"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉海報"
          }
        }
      }
    },
    "help.dragDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag up or down on the glow circle to manually adjust brightness. The level holds after release. Tap the percentage number to return to auto mode."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在光晕区域上下滑动手指，可手动调节亮度。松开后保持当前亮度。单击光晕区域的百分比数字，恢复自动调光。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在光暈區域上下滑動手指，可手動調整亮度。放開後保持目前亮度。點擊光暈區域的百分比數字，恢復自動調光。"
          }
        }
      }
    },
    "help.dragTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to Adjust"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑动调节亮度"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑動調整亮度"
          }
        }
      }
    },
    "help.endDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tap the glow circle to end your walk and generate a night poster. Walks with zero steps are not recorded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双击光晕区域结束本次步行，自动生成夜路海报。若步数为零，步行不会记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雙擊光暈區域結束本次步行，自動生成夜路海報。若步數為零，步行不會記錄。"
          }
        }
      }
    },
    "help.endTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double Tap to End"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双击结束步行"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雙擊結束步行"
          }
        }
      }
    },
    "help.historyDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap any walk in your history to view and share its night poster again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步行历史中点击任意记录，可重新查看和分享该次步行的夜路海报。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步行歷史中點擊任意記錄，可重新查看和分享該次步行的夜路海報。"
          }
        }
      }
    },
    "help.historyTitle" : {
      "extractionState" : "manual",
