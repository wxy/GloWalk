    "help.historyDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen Sie auf einen Spaziergang im Verlauf, um sein Nachtposter erneut anzusehen und zu teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap any walk in your history to view and share its night poster again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca cualquier paseo del historial para volver a ver y compartir su póster nocturno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une marche dans l'historique pour revoir et partager son poster nocturne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca una passeggiata nella cronologia per rivedere e condividere il suo poster notturno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴の歩行をタップすると、その夜のポスターを再表示・共有できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록에서 걷기를 탭하면 해당 밤의 포스터를 다시 보고 공유할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em qualquer caminhada no histórico para rever e compartilhar o pôster noturno dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на любую прогулку в истории, чтобы снова посмотреть и поделиться её ночным постером."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步行历史中点击任意记录，可重新查看和分享该次步行的夜路海报。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步行歷史中點擊任意記錄，可重新查看和分享該次步行的夜路海報。"
          }
        }
      }
    },
