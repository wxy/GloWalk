    "camera.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk senses the darkness around you through the rear camera.\n\nNo photos are taken. No video is recorded.\nA glance every few seconds, then forgotten.\n\nYou may also adjust brightness by hand."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 用后摄像头感知环境明暗变化\n\n不拍照、不录像、不存储任何画面\n每 5 秒采样一次即丢弃\n\n拒绝后需手动调节亮度"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 用後置鏡頭感知環境明暗變化\n\n不拍照、不錄影、不儲存任何畫面\n每 5 秒取樣一次即丟棄\n\n拒絕後需手動調整亮度"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk は背面カメラで周囲の明るさを感知します。\n\n写真は撮りません。動画も録画しません。\n数秒ごとにひと目だけ確認し、すぐに破棄されます。\n\n明るさは手動でも調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk는 후면 카메라로 주변 밝기를 감지합니다.\n\n사진을 찍지 않으며, 영상을 녹화하지 않습니다.\n몇 초마다 한 번씩 살펴본 뒤 바로 버려집니다.\n\n밝기는 손으로 직접 조절할 수도 있습니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk détecte la luminosité ambiante grâce à la caméra arrière.\n\nAucune photo n'est prise. Aucune vidéo n'est enregistrée.\nUn coup d'œil toutes les quelques secondes, puis tout est oublié.\n\nVous pouvez aussi régler la luminosité à la main."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk erfasst die Umgebungshelligkeit über die rückseitige Kamera.\n\nEs werden keine Fotos aufgenommen und keine Videos aufgezeichnet.\nEin kurzer Blick alle paar Sekunden – dann verworfen.\n\nSie können die Helligkeit auch manuell einstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk detecta la luz ambiental con la cámara trasera.\n\nNo se toman fotos ni se graban vídeos.\nUna mirada cada pocos segundos y nada se guarda.\n\nTambién puedes ajustar el brillo manualmente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GloWalk detecta a luminosidade ao redor com a câmera traseira.\n\nNenhuma foto é tirada. Nenhum vídeo é gravado.\nUma olhada a cada poucos segundos, e logo é descartada.\n\nVocê também pode ajustar o brilho manualmente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk rileva la luminosità intorno a te con la fotocamera posteriore.\n\nNessuna foto. Nessun video.\nUno sguardo ogni pochi secondi, poi tutto viene dimenticato.\n\nPuoi anche regolare la luminosità a mano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk определяет освещённость вокруг вас с помощью задней камеры.\n\nНикаких фото. Никакого видео.\nВзгляд каждые несколько секунд — и всё забыто.\n\nЯркость также можно регулировать вручную."
          }
        }
      }
    },
