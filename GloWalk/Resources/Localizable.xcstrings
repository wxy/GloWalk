    "help.quietDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach 12 Sekunden ohne Eingabe verblassen Zusatzinformationen. Berühren blendet sie ein. Pausen und Hinweise bleiben sichtbar. Poster zeigen abstrakte Wege und Lichtwechsel ohne Ortsnamen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After 12 seconds without interaction, secondary information fades. Touch to reveal it. Pauses and notices stay visible. Posters preserve abstract paths and light changes without place labels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras 12 segundos sin interacción se atenúa la información secundaria. Toca para verla. Pausas y avisos siguen visibles. Los pósteres conservan trazos abstractos y cambios de luz, sin nombres de lugares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après 12 secondes sans action, les informations secondaires s’effacent. Touchez pour les retrouver. Pauses et alertes restent visibles. Les affiches gardent un tracé abstrait et les variations de lumière, sans noms de lieux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo 12 secondi senza interazioni, le informazioni secondarie sfumano. Tocca per mostrarle. Pause e avvisi restano visibili. I poster conservano tracce astratte e variazioni di luce senza nomi di luoghi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12秒操作しないと補助情報が薄くなり、触れると戻ります。停止と通知は表示されます。ポスターには地名のない抽象的な足跡と光の変化を残します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12초간 조작하지 않으면 보조 정보가 사라지고 터치하면 돌아옵니다. 정지와 알림은 유지됩니다. 포스터는 장소 이름 없이 추상적인 발자취와 빛의 변화를 남깁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após 12 segundos sem interação, informações secundárias desaparecem. Toque para vê-las. Pausas e avisos continuam visíveis. Pôsteres guardam traços abstratos e mudanças de luz sem nomes de lugares."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через 12 секунд без действий второстепенные данные исчезают. Коснитесь для возврата. Паузы и уведомления остаются видимыми. Постеры сохраняют абстрактные следы и изменения света без названий мест."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 秒不操作后，次要信息淡出；触摸即可唤回。暂停和提示保持可见。海报保留抽象足迹和灯光变化，不标注地点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 秒不操作後，次要資訊淡出；觸摸即可喚回。暫停和提示保持可見。海報保留抽象足跡和燈光變化，不標註地點。"
          }
        }
      }
    },
