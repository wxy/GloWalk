    "help.togglesDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Rückkamerasteuerung zeigen Karten nur Informationen (—), ohne Schalter. Im Ersatzmodus sind Faktoren schaltbar. Prozentwerte sind Modellschätzungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With rear-camera feedback, factor cards show context only (—); toggles are unavailable. In fallback auto mode, cards control the factor model. The displayed percentages are model estimates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la cámara trasera, las tarjetas solo informan (—) y no se pueden cambiar. En el modo alternativo se pueden activar factores. Los porcentajes son estimaciones del modelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec la caméra arrière, les cartes sont informatives (—), sans interrupteurs. En mode automatique de secours, les facteurs sont réglables. Les pourcentages sont des estimations du modèle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la fotocamera posteriore, le schede sono informative (—) e non modificabili. Nella modalità alternativa puoi cambiare i fattori. Le percentuali sono stime del modello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背面カメラ制御中のカードは参考情報（—）で、切り替えできません。代替の自動モードでは要因を切り替えられ、割合はモデルの推定値です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "후면 카메라 제어 중 카드는 참고 정보(—)이며 전환할 수 없습니다. 대체 자동 모드에서는 요인을 전환할 수 있으며 백분율은 모델 추정치입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a câmera traseira, os cartões apenas informam (—), sem controles. No modo alternativo, é possível alternar fatores. Os percentuais são estimativas do modelo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При управлении задней камерой карточки только информируют (—), без переключателей. В резервном авторежиме факторы можно менять. Проценты — оценки модели."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后摄闭环可用时，因素卡片仅提供环境信息（—），不可开关。备用自动模式下可切换因素，百分比为模型估算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "後攝閉環可用時，因素卡片僅提供環境資訊（—），不可開關。備用自動模式下可切換因素，百分比為模型估算。"
          }
        }
      }
    },
