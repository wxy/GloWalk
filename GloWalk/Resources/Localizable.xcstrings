    "camera.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk erfasst die Umgebungshelligkeit mit der vorderen Kamera und, auf unterstützten Geräten, Bodenreflexionen mit der hinteren Kamera.\n\nEs werden keine Fotos aufgenommen und keine Videos aufgezeichnet.\nEin kurzer Blick alle paar Sekunden – dann verworfen.\n\nSie können die Helligkeit auch manuell einstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk senses ambient brightness with the front camera and reads ground reflection with the rear camera where supported.\n\nNo photos are taken. No video is recorded.\nA glance every few seconds, then forgotten.\n\nYou may also adjust brightness by hand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk detecta la luz ambiental con la cámara delantera y, en los dispositivos compatibles, lee los reflejos del suelo con la cámara trasera.\n\nNo se toman fotos ni se graban vídeos.\nUna mirada cada pocos segundos y nada se guarda.\n\nTambién puedes ajustar el brillo manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk détecte la luminosité ambiante avec la caméra avant et, sur les appareils compatibles, lit les reflets du sol avec la caméra arrière.\n\nAucune photo n'est prise. Aucune vidéo n'est enregistrée.\nUn coup d'œil toutes les quelques secondes, puis tout est oublié.\n\nVous pouvez aussi régler la luminosité à la main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk rileva la luminosità ambientale con la fotocamera anteriore e, sui dispositivi supportati, legge i riflessi del suolo con quella posteriore.\n\nNessuna foto. Nessun video.\nUno sguardo ogni pochi secondi, poi tutto viene dimenticato.\n\nPuoi anche regolare la luminosità a mano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk は前面カメラで環境の明るさを感知し、対応デバイスでは背面カメラで路面の反射光も読み取ります。\n\n写真は撮りません。動画も録画しません。\n数秒ごとにひと目だけ確認し、すぐに破棄されます。\n\n明るさは手動でも調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk는 전면 카메라로 주변 밝기를 감지하고, 지원되는 기기에서는 후면 카메라로 바닥 반사광도 읽습니다.\n\n사진을 찍지 않으며, 영상을 녹화하지 않습니다.\n몇 초마다 한 번씩 살펴본 뒤 바로 버려집니다.\n\n밝기는 손으로 직접 조절할 수도 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GloWalk detecta a luminosidade ambiente com a câmera frontal e, em aparelhos compatíveis, lê o reflexo do chão com a câmera traseira.\n\nNenhuma foto é tirada. Nenhum vídeo é gravado.\nUma olhada a cada poucos segundos, e logo é descartada.\n\nVocê também pode ajustar o brilho manualmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk определяет окружающую освещённость передней камерой, а на поддерживаемых устройствах считывает отражение от земли задней камерой.\n\nНикаких фото. Никакого видео.\nВзгляд каждые несколько секунд — и всё забыто.\n\nЯркость также можно регулировать вручную."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 用前置摄像头感知环境明暗，支持的设备上以后置摄像头读取路面反光\n\n不拍照、不录像、不存储任何画面\n每 5 秒采样一次即丢弃\n\n拒绝后需手动调节亮度"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 用前置鏡頭感知環境明暗，支援的裝置上以後置鏡頭讀取路面反光\n\n不拍照、不錄影、不儲存任何畫面\n每 5 秒取樣一次即丟棄\n\n拒絕後需手動調整亮度"
          }
        }
      }
    },
