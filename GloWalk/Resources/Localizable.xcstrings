    "help.longPressDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Licht 0,6 Sekunden halten, um Beleuchtung und Aufzeichnung zu pausieren. Zum Fortsetzen tippen. Sperren oder Verlassen der App pausiert ebenfalls. Pausenzeit und Bewegung werden nicht gezählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold the glow for 0.6 seconds to pause the light and recording. Tap to continue. Locking or leaving the app also pauses; return and tap to continue. Paused time and movement are excluded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la luz 0,6 segundos para pausar la iluminación y el registro. Toca para continuar. Bloquear o salir de la app también pausa. El tiempo y movimiento en pausa no cuentan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez la lueur 0,6 seconde pour arrêter l’éclairage et l’enregistrement. Touchez pour reprendre. Verrouiller ou quitter l’app met aussi en pause. Le temps et les déplacements en pause sont exclus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuta la luce per 0,6 secondi per sospendere luce e registrazione. Tocca per riprendere. Anche bloccare o uscire dall’app mette in pausa. Tempo e spostamenti in pausa sono esclusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光を0.6秒長押しすると照明と記録が一時停止します。タップで再開。画面ロックやアプリを離れた場合も停止します。停止中の時間と移動は含みません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빛을 0.6초간 누르면 조명과 기록이 정지됩니다. 탭하여 계속하세요. 화면 잠금이나 앱 이탈 시에도 정지됩니다. 정지 중 시간과 이동은 제외합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure a luz por 0,6 segundo para pausar a iluminação e o registro. Toque para continuar. Bloquear ou sair do app também pausa. Tempo e movimento durante a pausa não contam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте свечение 0,6 секунды для паузы света и записи. Коснитесь для продолжения. Блокировка или выход из приложения также включает паузу. Время и движение на паузе не учитываются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按光晕 0.6 秒暂停照明与记录，轻点继续。锁屏或离开应用也会暂停，回来轻点继续。暂停期间的时长与移动不计入记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按光暈 0.6 秒暫停照明與記錄，輕點繼續。鎖屏或離開應用也會暫停，回來輕點繼續。暫停期間的時長與移動不計入記錄。"
          }
        }
      }
    },
