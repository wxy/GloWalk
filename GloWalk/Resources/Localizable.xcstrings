    "help.endDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelt auf das Licht oder auf Stopp tippen und bestätigen. Nur Spaziergänge mit Schritten, Strecke, Verlauf und aktiver Dauer werden gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tap the glow or tap Stop, then confirm to end. Only walks with steps, distance, a recorded path and active time are saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces la luz o pulsa Detener y confirma. Solo se guardan paseos con pasos, distancia, trazado y tiempo activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois la lueur ou le bouton Arrêter, puis confirmez. Seules les marches avec pas, distance, tracé et durée active sont enregistrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte la luce o il pulsante Stop, poi conferma. Si salvano solo camminate con passi, distanza, tracciato e durata attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光をダブルタップするか終了ボタンを押し、確認します。歩数・距離・軌跡・有効時間が揃った歩行だけ保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빛을 두 번 탭하거나 종료 버튼을 누른 뒤 확인하세요. 걸음 수, 거리, 경로와 유효 시간이 모두 있는 기록만 저장합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes na luz ou em Parar e confirme. Só são salvas caminhadas com passos, distância, trajeto e tempo ativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дважды коснитесь свечения или нажмите Стоп, затем подтвердите. Сохраняются только прогулки с шагами, расстоянием, треком и активным временем."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双击光晕或点击结束按钮，确认后结束。仅保存同时具备步数、距离、轨迹和有效时长的步行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按兩下光暈或點擊結束按鈕，確認後結束。僅儲存同時具備步數、距離、軌跡和有效時長的步行。"
          }
        }
      }
    },
    "help.endTitle" : {
