    "hud.cameraDeniedMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk relies on the rear camera to sense ambient light and automatically adjust brightness. Without it, you'll need to control brightness manually."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 通过后置摄像头感知环境光并自动调节亮度。没有相机权限，你需要手动控制亮度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 透過後置鏡頭感知環境光並自動調整亮度。沒有相機權限，你需要手動控制亮度。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk は背面カメラで環境光を感知し、明るさを自動調整します。カメラを使えない場合は、明るさを手動で調整してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk는 후면 카메라로 주변광을 감지해 밝기를 자동으로 조절합니다. 카메라가 없으면 밝기를 직접 조절해야 합니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk utilise la caméra arrière pour détecter la lumière ambiante et ajuster automatiquement la luminosité. Sans elle, vous devrez régler la luminosité manuellement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk nutzt die Rückkamera, um Umgebungslicht zu erfassen und die Helligkeit automatisch anzupassen. Ohne sie müssen Sie die Helligkeit manuell steuern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk usa la cámara trasera para detectar la luz ambiental y ajustar el brillo automáticamente. Sin ella, tendrás que controlar el brillo manualmente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GloWalk usa a câmera traseira para detectar a luz ambiente e ajustar o brilho automaticamente. Sem ela, você precisará controlar o brilho manualmente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk usa la fotocamera posteriore per rilevare la luce ambientale e regolare la luminosità automaticamente. Senza, dovrai controllare la luminosità a mano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk использует заднюю камеру, чтобы определять окружающий свет и автоматически регулировать яркость. Без неё яркость придётся контролировать вручную."
          }
        }
      }
    },
