    "location.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk records your walking path to draw constellation trails on your night poster.\n\nAll path data stays on your device. Your location is sent to Apple WeatherKit and Open-Meteo only for current weather.\n\nYou can still walk without it; the path will be coarser."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 记录你的步行路径，用于在夜路海报上绘制星座般的足迹。\n\n所有路径数据仅存于本机。位置信息仅用于向 Apple WeatherKit 和 Open-Meteo 获取当前天气。\n\n拒绝后仍可步行，但路径精度会降低。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 記錄你的步行路徑，用於在夜路海報上繪製星座般的足跡。\n\n所有路徑數據僅存於本機。位置資訊僅用於向 Apple WeatherKit 和 Open-Meteo 取得目前天氣。\n\n拒絕後仍可步行，但路徑精度會降低。"
          }
        }
      }
    },
