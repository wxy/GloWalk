    "privacy.item4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können jede Berechtigung jederzeit in den Einstellungen entziehen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can revoke any permission at any time in Settings"
