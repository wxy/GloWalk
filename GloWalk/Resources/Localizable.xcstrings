    "help.longPressDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long-press the glow circle for 0.8 seconds to temporarily turn off the flashlight without ending your walk. Long-press again to resume. The percentage shows a strikethrough when paused."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按光晕区域 0.8 秒，可临时关闭手电筒，不结束步行。再次长按恢复。关灯时百分比显示删除线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按光暈區域 0.8 秒，可暫時關閉手電筒，不結束步行。再次長按恢復。關燈時百分比顯示刪除線。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光の輪を 0.8 秒長押しすると、歩行を終了せずに一時的にライトを消せます。もう一度長押しすると再開します。一時停止中はパーセント表示に取り消し線が付きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빛 원을 0.8초 길게 누르면 걷기를 끝내지 않고 손전등을 잠시 끌 수 있습니다. 다시 길게 누르면 재개됩니다. 일시정지 중에는 백분율에 취소선이 표시됩니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez longuement sur le cercle lumineux (0,8 s) pour éteindre temporairement la torche sans terminer la marche. Appuyez de nouveau longuement pour reprendre. Le pourcentage est barré pendant la pause."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langes Drücken (0,8 s) auf den Leuchtkreis schaltet die Taschenlampe vorübergehend aus, ohne den Spaziergang zu beenden. Erneut langes Drücken setzt fort. Bei Pause wird die Prozentzahl durchgestrichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el círculo de luz 0,8 s para apagar temporalmente la linterna sin terminar el paseo. Pulsa de nuevo para reanudar. Durante la pausa, el porcentaje aparece tachado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione e segure o círculo de luz por 0,8 s para desligar temporariamente a lanterna sem encerrar a caminhada. Pressione novamente para retomar. Durante a pausa, o percentual fica riscado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto il cerchio di luce per 0,8 secondi per spegnere temporaneamente la torcia senza terminare la passeggiata. Tieni premuto di nuovo per riprendere. In pausa la percentuale è barrata."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Долгое нажатие (0,8 с) на светящийся круг временно выключает фонарик, не завершая прогулку. Нажмите ещё раз, чтобы возобновить. На паузе процент перечёркнут."
          }
        }
      }
    },
