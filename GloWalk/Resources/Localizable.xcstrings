          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완료된 걷기(걸음 수·거리·시간·경로)를 건강 App에 기록합니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
