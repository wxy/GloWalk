    "help.longPressDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long-press the glow circle for 0.8 seconds to temporarily turn off the flashlight without ending your walk. Long-press again to resume. The percentage shows a strikethrough when paused."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按光晕区域 0.8 秒，可临时关闭手电筒，不结束步行。再次长按恢复。关灯时百分比显示删除线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按光暈區域 0.8 秒，可暫時關閉手電筒，不結束步行。再次長按恢復。關燈時百分比顯示刪除線。"
          }
        }
      }
    },
    "help.longPressTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long Press to Pause"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按关灯"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
