    "help.togglesDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap any of the five factor cards at the bottom to toggle it. When off, it no longer affects brightness and its delta goes to zero. Card width reflects weight — Ambient is widest (40%), others 15% each."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "底部五个因素卡片均可点击开关。关闭后该因素不再影响亮度计算，数值归零变灰。卡片宽度反映其在亮度决策中的权重——环境光最宽（40%），其余四个各 15%。"
          }
        }
      }
    },
    "help.togglesTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
