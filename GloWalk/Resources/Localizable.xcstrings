    "privacy.item1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera only senses ambient light — no photos, no video, no storage"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摄像头仅用于感知环境光线，不拍照、不录像、不存储画面"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相機僅用於感知環境光線，不拍照、不錄影、不儲存畫面"
          }
        }
      }
    },
    "privacy.item2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Path data stays on your device; your location is sent to Apple WeatherKit and Open-Meteo only for current weather"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路径数据只存于你的手机；位置信息仅用于向 Apple WeatherKit 和 Open-Meteo 获取当前天气"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路徑數據只存於你的手機；位置資訊僅用於向 Apple WeatherKit 和 Open-Meteo 取得目前天氣"
          }
        }
      }
    },
    "privacy.item3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No ads, no tracking, no analytics"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有广告、没有追踪、没有分析"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有廣告、沒有追蹤、沒有分析"
          }
        }
      }
    },
