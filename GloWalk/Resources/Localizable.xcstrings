    "help.endDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tap the glow circle to end your walk and generate a night poster. Walks with zero steps are not recorded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双击光晕区域结束本次步行，自动生成夜路海报。若步数为零，步行不会记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雙擊光暈區域結束本次步行，自動生成夜路海報。若步數為零，步行不會記錄。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光の輪をダブルタップすると歩行を終了し、夜のポスターが生成されます。歩数がゼロの歩行は記録されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빛 원을 두 번 탭하면 걷기를 마치고 밤 포스터가 생성됩니다. 걸음 수가 0이면 기록되지 않습니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-touchez le cercle lumineux pour terminer votre marche et générer un poster nocturne. Les marches à zéro pas ne sont pas enregistrées."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppeltippen Sie auf den Leuchtkreis, um den Spaziergang zu beenden und ein Nachtposter zu erzeugen. Spaziergänge ohne Schritte werden nicht gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces el círculo de luz para terminar el paseo y generar un póster nocturno. Los paseos con cero pasos no se registran."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes no círculo de luz para encerrar a caminhada e gerar um pôster noturno. Caminhadas com zero passos não são registradas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte il cerchio di luce per terminare la passeggiata e generare un poster notturno. Le passeggiate con zero passi non vengono registrate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дважды коснитесь светящегося круга, чтобы завершить прогулку и создать ночной постер. Прогулки с нулём шагов не записываются."
          }
        }
      }
    },
    "help.endTitle" : {
