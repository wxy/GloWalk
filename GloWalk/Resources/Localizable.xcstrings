    "location.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk records your walking path to draw constellation trails on your night poster.\n\nAll path data stays on your device — never uploaded.\n\nYou can still walk without it; the path will be coarser."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 记录你的步行路径，用于在夜路海报上绘制星座般的足迹。\n\n所有路径数据仅存于本机，不会上传。\n\n拒绝后仍可步行，但路径精度会降低。"
          }
        }
      }
    },
