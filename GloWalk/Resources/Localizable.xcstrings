          }
        }
      }
    },
    "permissions.health.feature2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only writes — never reads Health data; data stays on your device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只写入、不读取任何健康数据；数据仅保存在本机。"
