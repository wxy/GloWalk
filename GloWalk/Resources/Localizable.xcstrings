    "Français" : {

    },
    "help.autoDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kameramessung steuert das Licht. Rückmeldung der Rückkamera hat Vorrang, sonst wird ein Faktorenmodell verwendet. Manuelle Helligkeit bleibt bis zur Rückkehr zur Automatik erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk adjusts light using camera measurements. Where available, rear-camera feedback controls the light; otherwise a factor model is used. Manual brightness is retained until you restore auto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luz se ajusta mediante las cámaras. Se usa la respuesta de la cámara trasera si está disponible; si no, un modelo de factores. El brillo manual se mantiene hasta volver a Auto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’éclairage utilise les mesures des caméras. Le retour de la caméra arrière est prioritaire ; sinon, un modèle de facteurs est utilisé. Le réglage manuel reste jusqu’au retour en Auto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luce usa le misurazioni delle fotocamere. Il feedback posteriore ha priorità; altrimenti viene usato un modello di fattori. La luminosità manuale resta fino al ritorno ad Auto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラの測定で調光します。背面カメラのフィードバックが使える場合はそれを優先し、それ以外は要因モデルを使用します。手動設定は自動に戻すまで保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라 측정으로 밝기를 조절합니다. 후면 카메라 피드백이 가능하면 이를 사용하고, 아니면 요인 모델을 사용합니다. 수동 설정은 자동으로 돌아갈 때까지 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A luz usa medições das câmeras. O retorno da câmera traseira tem prioridade; caso contrário, usa um modelo de fatores. O brilho manual permanece até voltar ao automático."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свет регулируется по данным камер. Приоритет у обратной связи задней камеры; иначе используется модель факторов. Ручная яркость сохраняется до возврата в авторежим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 根据摄像头测量自动调光。后摄反馈可用时由闭环控制，否则使用因素模型。手动亮度会保持，直到你恢复自动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 根據攝像頭測量自動調光。後攝反饋可用時由閉環控制，否則使用因素模型。手動亮度會保持，直到你恢復自動。"
          }
        }
      }
    },
