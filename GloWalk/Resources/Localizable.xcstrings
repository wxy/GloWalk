    "help.dismissDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wischen Sie das Poster nach unten, um es zu schließen und zum Verlauf zurückzukehren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe down on the poster to dismiss it and return to walk history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza el póster hacia abajo para cerrarlo y volver al historial de paseos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez le poster vers le bas pour le fermer et revenir à l'historique des marches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri il poster verso il basso per chiuderlo e tornare alla cronologia delle passeggiate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポスターを下にスワイプすると閉じて、歩行履歴に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포스터를 아래로 스와이프하면 닫히고 걷기 기록으로 돌아갑니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize o pôster para baixo para fechá-lo e voltar ao histórico de caminhadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните постер вниз, чтобы закрыть его и вернуться к истории прогулок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在海报页面向下滑动即可关闭，返回步行历史。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在海報頁面向下滑動即可關閉，返回步行歷史。"
          }
        }
      }
    },
