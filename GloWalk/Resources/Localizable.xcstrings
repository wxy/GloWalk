    "help.autoDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk senses ambient brightness via the rear camera and combines phone posture, dark adaptation, moon phase, and weather to compute optimal brightness in real time. No manual input needed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 通过后置摄像头感知环境明暗，结合手机姿态、暗适应、月相和天气，实时计算最合适的亮度。无需手动操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk 透過後置鏡頭感知環境明暗，結合手機姿態、暗適應、月相和天氣，即時計算最合適的亮度。無需手動操作。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk は背面カメラで環境の明るさを感知し、スマホの姿勢・暗順応・月相・天気を組み合わせて、最適な明るさをリアルタイムに計算します。手動操作は不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk는 후면 카메라로 주변 밝기를 감지하고, 기기 자세·암순응·달의 위상·날씨를 종합해 최적의 밝기를 실시간으로 계산합니다. 수동 조작이 필요 없습니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk mesure la luminosité ambiante via la caméra arrière et combine posture du téléphone, adaptation à l'obscurité, phase de lune et météo pour calculer en temps réel la luminosité idéale. Aucune intervention manuelle requise."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk erfasst die Umgebungshelligkeit über die Rückkamera und berechnet aus Handyhaltung, Dunkeladaptation, Mondphase und Wetter in Echtzeit die optimale Helligkeit. Kein manuelles Eingreifen nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk detecta la luminosidad ambiental con la cámara trasera y combina la postura del teléfono, la adaptación a la oscuridad, la fase lunar y el tiempo para calcular el brillo óptimo en tiempo real. No requiere intervención manual."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GloWalk detecta a luminosidade ambiente pela câmera traseira e combina postura do aparelho, adaptação ao escuro, fase da lua e clima para calcular o brilho ideal em tempo real. Nenhuma ação manual é necessária."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk rileva la luminosità ambientale con la fotocamera posteriore e combina postura del telefono, adattamento al buio, fase lunare e meteo per calcolare in tempo reale la luminosità ottimale. Nessun intervento manuale richiesto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GloWalk определяет окружающую освещённость задней камерой и сочетает положение телефона, адаптацию к темноте, фазу Луны и погоду, чтобы в реальном времени вычислять оптимальную яркость. Ручное управление не требуется."
          }
        }
      }
    },
