    "privacy.item1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera dient nur der Erfassung von Umgebungslicht – keine Fotos, keine Videos, keine Speicherung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera only senses ambient light — no photos, no video, no storage"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara solo detecta luz ambiental: sin fotos, sin vídeos, sin almacenamiento"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La caméra ne sert qu'à détecter la lumière ambiante — pas de photos, pas de vidéos, pas de stockage"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fotocamera rileva solo la luce ambientale — niente foto, niente video, nessuna memorizzazione"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラは環境光の感知にのみ使われます — 写真も動画も撮らず、保存もしません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라는 주변광 감지에만 사용됩니다 — 사진도 영상도 찍지 않고 저장하지 않습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A câmera serve apenas para detectar luz ambiente — sem fotos, sem vídeos, sem armazenamento"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера используется только для определения окружающего света — никаких фото, видео и сохранений"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摄像头仅用于感知环境光线，不拍照、不录像、不存储画面"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相機僅用於感知環境光線，不拍照、不錄影、不儲存畫面"
          }
        }
      }
    },
    "privacy.item2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wegdaten bleiben auf Ihrem Gerät; Ihr Standort wird nur für das aktuelle Wetter an Apple WeatherKit und Open-Meteo gesendet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Path data stays on your device; your location is sent to Apple WeatherKit and Open-Meteo only for current weather"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de ruta permanecen en tu dispositivo; tu ubicación solo se envía a Apple WeatherKit y Open-Meteo para el tiempo actual"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de trajet restent sur votre appareil ; votre position n'est envoyée à Apple WeatherKit et Open-Meteo que pour la météo actuelle"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati del percorso restano sul tuo dispositivo; la posizione viene inviata ad Apple WeatherKit e Open-Meteo solo per il meteo attuale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経路データは端末内にのみ保存されます。位置情報は現在の天気のために Apple WeatherKit と Open-Meteo にのみ送信されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경로 데이터는 기기에만 저장됩니다. 위치 정보는 현재 날씨를 위해 Apple WeatherKit과 Open-Meteo에만 전송됩니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados do trajeto ficam no seu aparelho; sua localização é enviada ao Apple WeatherKit e ao Open-Meteo apenas para o clima atual"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные маршрута остаются на вашем устройстве; геопозиция передаётся в Apple WeatherKit и Open-Meteo только для текущей погоды"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路径数据只存于你的手机；位置信息仅用于向 Apple WeatherKit 和 Open-Meteo 获取当前天气"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路徑數據只存於你的手機；位置資訊僅用於向 Apple WeatherKit 和 Open-Meteo 取得目前天氣"
          }
        }
      }
    },
    "privacy.item3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Werbung, kein Tracking, keine Analyse"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No ads, no tracking, no analytics"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin anuncios, sin seguimiento, sin análisis"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de publicité, pas de suivi, pas d'analyse"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente pubblicità, niente tracciamento, niente analisi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
