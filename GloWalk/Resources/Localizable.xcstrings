    "help.dragDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag up or down on the glow circle to manually adjust brightness. The level holds after release. Tap the percentage number to return to auto mode."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在光晕区域上下滑动手指，可手动调节亮度。松开后保持当前亮度。单击光晕区域的百分比数字，恢复自动调光。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在光暈區域上下滑動手指，可手動調整亮度。放開後保持目前亮度。點擊光暈區域的百分比數字，恢復自動調光。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光の輪を上下にドラッグすると明るさを手動調整できます。離すとその明るさに固定されます。パーセント表示をタップすると自動モードに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빛 원을 위아래로 드래그하면 밝기를 수동으로 조절할 수 있습니다. 손을 떼면 그 밝기가 유지됩니다. 백분율 숫자를 탭하면 자동 모드로 돌아갑니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le cercle lumineux vers le haut ou le bas pour régler la luminosité manuellement. Le niveau reste après le lâcher. Touchez le pourcentage pour revenir au mode automatique."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie den Leuchtkreis nach oben oder unten, um die Helligkeit manuell einzustellen. Nach dem Loslassen bleibt der Wert erhalten. Tippen Sie auf die Prozentzahl, um in den Automatikmodus zurückzukehren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia arriba o abajo sobre el círculo de luz para ajustar el brillo manualmente. El nivel se mantiene al soltar. Toca el porcentaje para volver al modo automático."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste o círculo de luz para cima ou para baixo para ajustar o brilho manualmente. O nível é mantido ao soltar. Toque no percentual para voltar ao modo automático."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina il cerchio di luce verso l'alto o il basso per regolare la luminosità manualmente. Il livello resta dopo il rilascio. Tocca la percentuale per tornare in modalità automatica."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свайпните по светящемуся кругу вверх или вниз, чтобы вручную отрегулировать яркость. Уровень сохранится после отпускания. Нажмите на процент, чтобы вернуться в автоматический режим."
          }
        }
      }
    },
    "help.dragTitle" : {
