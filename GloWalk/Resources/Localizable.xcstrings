    "help.dragDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licht zum Dimmen ziehen. Ganz unten geht nur das Licht aus; die Aufzeichnung läuft weiter. Tippen stellt Automatik wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag the glow to adjust brightness; drag to the bottom to turn off only the light. Recording continues. Tap the glow to restore auto brightness."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra la luz para ajustar el brillo. Abajo del todo solo se apaga la luz; el registro continúa. Toca para volver a Auto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la lueur pour régler l’intensité. Tout en bas, seule la lumière s’éteint ; l’enregistrement continue. Touchez pour rétablir Auto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina la luce per regolare la luminosità. In fondo si spegne solo la luce; la registrazione continua. Tocca per tornare ad Auto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光をドラッグして調光。最下部では照明だけ消え、記録は続きます。タップで自動調光に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빛을 드래그하여 밝기를 조절하세요. 맨 아래로 내리면 조명만 꺼지고 기록은 계속됩니다. 탭하면 자동으로 돌아갑니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste a luz para ajustar o brilho. Na parte inferior, só a luz se apaga; o registro continua. Toque para voltar ao automático."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетаскивайте свечение для регулировки яркости. Внизу выключается только свет; запись продолжается. Касание возвращает авторежим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动光晕调节亮度；拖到底部仅关灯，记录继续。轻点光晕恢复自动调光。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖動光暈調節亮度；拖到底部僅關燈，記錄繼續。輕點光暈恢復自動調光。"
          }
        }
      }
    },
